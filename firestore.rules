rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function memberPath(companyId, uid) {
      return /databases/$(database)/documents/companies/$(companyId)/members/$(uid);
    }
    function isMember(companyId) {
      return signedIn()
        && exists(memberPath(companyId, request.auth.uid))
        && get(memberPath(companyId, request.auth.uid)).data.status == 'active';
    }
    function hasPendingInvite(companyId) {
      return signedIn()
        && request.auth.token.email is string
        && exists(/databases/$(database)/documents/invites/$(request.auth.token.email))
        && get(/databases/$(database)/documents/invites/$(request.auth.token.email)).data.company_id == companyId
        && get(/databases/$(database)/documents/invites/$(request.auth.token.email)).data.status == 'pending';
    }
    function role(companyId) {
      return isMember(companyId)
        ? get(memberPath(companyId, request.auth.uid)).data.role
        : '';
    }
    function isAdmin(companyId) {
      return role(companyId) == 'admin';
    }
    function sameCompanyRecord() {
      return signedIn()
        && resource.data.company_id is string
        && isMember(resource.data.company_id);
    }
    function sameCompanyWrite() {
      return signedIn()
        && request.resource.data.company_id is string
        && isMember(request.resource.data.company_id);
    }
    function validTechnicianAssignment(companyId, data) {
      return !('technician_uid' in data)
        || data.technician_uid == ''
        || (data.technician_uid is string
          && exists(memberPath(companyId, data.technician_uid))
          && get(memberPath(companyId, data.technician_uid)).data.role == 'technician'
          && get(memberPath(companyId, data.technician_uid)).data.status == 'active');
    }
    function platformAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.platform_role == 'platform_admin';
    }
    function accountPath(companyId) {
      return /databases/$(database)/documents/companyAccounts/$(companyId);
    }
    function membershipPath(memberId) {
      return /databases/$(database)/documents/memberships/$(memberId);
    }
    function invitePath(email) {
      return /databases/$(database)/documents/invites/$(email);
    }
    function seatReservationAfter(companyId, email) {
      return existsAfter(accountPath(companyId))
        && getAfter(accountPath(companyId)).data.seat_change_email == email
        && getAfter(accountPath(companyId)).data.seat_change_action == 'reserve'
        && getAfter(accountPath(companyId)).data.reserved_users
          == get(accountPath(companyId)).data.reserved_users + 1
        && getAfter(accountPath(companyId)).data.reserved_users
          <= getAfter(accountPath(companyId)).data.max_users
        && getAfter(accountPath(companyId)).data.seat_change_member_id is string
        && existsAfter(membershipPath(getAfter(accountPath(companyId)).data.seat_change_member_id))
        && getAfter(membershipPath(getAfter(accountPath(companyId)).data.seat_change_member_id)).data.company_id == companyId
        && getAfter(membershipPath(getAfter(accountPath(companyId)).data.seat_change_member_id)).data.status in ['invited', 'active'];
    }
    function seatReleaseAfter(companyId, email, memberId) {
      return existsAfter(accountPath(companyId))
        && getAfter(accountPath(companyId)).data.seat_change_email == email
        && getAfter(accountPath(companyId)).data.seat_change_member_id == memberId
        && getAfter(accountPath(companyId)).data.seat_change_action == 'release'
        && getAfter(accountPath(companyId)).data.reserved_users
          == get(accountPath(companyId)).data.reserved_users - 1
        && getAfter(accountPath(companyId)).data.reserved_users >= 1
        && (
          !existsAfter(membershipPath(memberId))
          || (getAfter(membershipPath(memberId)).data.company_id == companyId
            && getAfter(membershipPath(memberId)).data.status == 'inactive')
        )
        && (
          !existsAfter(memberPath(companyId, memberId))
          || getAfter(memberPath(companyId, memberId)).data.status == 'inactive'
        );
    }
    function validSeatStatusChange(companyId, email, memberId, oldStatus, newStatus) {
      return (
        !(oldStatus in ['active', 'invited']) && (newStatus in ['active', 'invited'])
        && seatReservationAfter(companyId, email)
      ) || (
        (oldStatus in ['active', 'invited']) && !(newStatus in ['active', 'invited'])
        && seatReleaseAfter(companyId, email, memberId)
      ) || (
        (oldStatus in ['active', 'invited']) && (newStatus in ['active', 'invited'])
      );
    }

    function validOrderUsageAfter(companyId) {
      let before = get(accountPath(companyId)).data;
      let after = getAfter(accountPath(companyId)).data;
      return exists(accountPath(companyId))
        && existsAfter(accountPath(companyId))
        && after.orders_month_year == request.time.year()
        && after.orders_month_number == request.time.month()
        && after.orders_month_updated_at == request.time
        && after.orders_month_count is int
        && after.orders_month_count >= 1
        && after.orders_month_count <= after.max_orders_month
        && (
          (before.get('orders_month_year', 0) == request.time.year()
            && before.get('orders_month_number', 0) == request.time.month()
            && after.orders_month_count == before.orders_month_count + 1)
          || ((before.get('orders_month_year', 0) != request.time.year()
            || before.get('orders_month_number', 0) != request.time.month())
            && after.orders_month_count == 1)
        );
    }

    function orderUsageWithinLimitAfter(companyId) {
      let after = getAfter(accountPath(companyId)).data;
      return existsAfter(accountPath(companyId))
        && after.orders_month_year == request.time.year()
        && after.orders_month_number == request.time.month()
        && after.orders_month_count is int
        && after.orders_month_count >= 1
        && after.orders_month_count <= after.max_orders_month;
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && !('platform_role' in request.resource.data);
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['full_name', 'photo_url', 'updated_at', 'company_id', 'company_name', 'company_role'])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['company_id'])
          || (request.resource.data.company_id is string
            && existsAfter(memberPath(request.resource.data.company_id, uid)))
        );
      allow delete: if false;
    }

    match /companies/{companyId} {
      allow read: if isMember(companyId) || platformAdmin() || hasPendingInvite(companyId);
      allow create: if signedIn()
        && request.resource.data.owner_uid == request.auth.uid
        && existsAfter(memberPath(companyId, request.auth.uid))
        && getAfter(memberPath(companyId, request.auth.uid)).data.role == 'admin';
      allow update: if isAdmin(companyId)
        && request.resource.data.owner_uid == resource.data.owner_uid
        && request.resource.data.company_id == resource.data.company_id;
      allow delete: if false;

      match /members/{uid} {
        allow read: if signedIn() && (
          request.auth.uid == uid || isAdmin(companyId) || platformAdmin()
        );
        allow create: if signedIn() && (
          (request.auth.uid == uid
            && request.resource.data.uid == uid
            && exists(/databases/$(database)/documents/invites/$(request.auth.token.email))
            && get(/databases/$(database)/documents/invites/$(request.auth.token.email)).data.company_id == companyId
            && get(/databases/$(database)/documents/invites/$(request.auth.token.email)).data.status == 'pending'
            && request.resource.data.role == get(/databases/$(database)/documents/invites/$(request.auth.token.email)).data.role
            && request.resource.data.role in ['admin', 'attendant', 'technician']
            && request.resource.data.status == 'active')
          || (request.auth.uid == uid
            && request.resource.data.uid == uid
            && getAfter(/databases/$(database)/documents/companies/$(companyId)).data.owner_uid == uid
            && request.resource.data.role == 'admin'
            && request.resource.data.status == 'active')
        );
        allow update: if isAdmin(companyId)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'status'])
          && request.resource.data.role in ['admin', 'attendant', 'technician']
          && request.resource.data.status in ['active', 'inactive']
          && (
            request.resource.data.status == resource.data.status
            || validSeatStatusChange(companyId,
              get(membershipPath(uid)).data.user_email, uid,
              resource.data.status, request.resource.data.status)
          );
        allow delete: if isAdmin(companyId) && uid != request.auth.uid
          && (
            (resource.data.status == 'inactive' && !existsAfter(membershipPath(uid)))
            || seatReleaseAfter(companyId, get(membershipPath(uid)).data.user_email, uid)
          );
      }

      match /counters/{counterId} {
        allow read: if isMember(companyId);
        // Permite criar o contador inicial na mesma transação que cria a empresa
        // e ativa o primeiro membro administrador.
        allow create: if signedIn()
          && existsAfter(memberPath(companyId, request.auth.uid))
          && getAfter(memberPath(companyId, request.auth.uid)).data.status == 'active'
          && getAfter(memberPath(companyId, request.auth.uid)).data.role == 'admin'
          && request.resource.data.key == 'doc'
          && request.resource.data.value is int
          && request.resource.data.value > 0;
        allow update: if isAdmin(companyId)
          && request.resource.data.key == 'doc'
          && request.resource.data.value is int
          && request.resource.data.value > 0;
        allow delete: if false;
      }

      match /auditLogs/{logId} {
        allow read: if isAdmin(companyId);
        allow create: if isMember(companyId);
        allow update, delete: if false;
      }
    }

    match /invites/{email} {
      allow read: if signedIn() && (
        resource == null
        || request.auth.token.email == resource.data.email
        || (resource.data.company_id is string && isAdmin(resource.data.company_id))
        || platformAdmin()
      );
      allow create: if signedIn()
        && request.resource.data.company_id is string
        && request.resource.data.email == email
        && isAdmin(request.resource.data.company_id)
        && seatReservationAfter(request.resource.data.company_id, email);
      allow update: if signedIn() && (
        (resource.data.company_id is string
          && isAdmin(resource.data.company_id)
          && request.resource.data.company_id == resource.data.company_id
          && request.resource.data.email == resource.data.email
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'role', 'status', 'updated_at'
          ])
          && request.resource.data.role in ['admin', 'attendant', 'technician']
          && request.resource.data.status in ['pending', 'inactive']
          && (
            request.resource.data.status == resource.data.status
            || validSeatStatusChange(resource.data.company_id, email, email,
              resource.data.status == 'pending' ? 'invited' : 'inactive',
              request.resource.data.status == 'pending' ? 'invited' : 'inactive')
          ))
        || (request.auth.token.email == resource.data.email
          && resource.data.status == 'pending'
          && request.resource.data.status == 'accepted'
          && request.resource.data.accepted_by == request.auth.uid
          && request.resource.data.company_id == resource.data.company_id
          && request.resource.data.email == resource.data.email
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'accepted_by', 'accepted_at'
          ]))
      );
      allow delete: if signedIn()
        && resource.data.company_id is string
        && isAdmin(resource.data.company_id)
        && (
          (resource.data.status == 'inactive' && !existsAfter(membershipPath(email)))
          || seatReleaseAfter(resource.data.company_id, email, email)
        );
    }

    match /memberships/{membershipId} {
      allow read: if signedIn() && (
        membershipId == request.auth.uid
        || platformAdmin()
        || (resource.data.company_id is string && isAdmin(resource.data.company_id))
        || (resource.data.company_id is string
          && isMember(resource.data.company_id)
          && resource.data.status == 'active')
      );
      allow create: if signedIn() && (
        (membershipId == request.auth.uid
          && request.resource.data.user_id == request.auth.uid
          && existsAfter(memberPath(request.resource.data.company_id, request.auth.uid)))
        || (request.resource.data.company_id is string
          && request.resource.data.user_email == membershipId
          && isAdmin(request.resource.data.company_id)
          && seatReservationAfter(request.resource.data.company_id, membershipId))
      );
      allow update: if signedIn() && resource.data.company_id is string
        && isAdmin(resource.data.company_id)
        && request.resource.data.company_id == resource.data.company_id
        && request.resource.data.user_id == resource.data.user_id
        && request.resource.data.user_email == resource.data.user_email
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'role', 'status', 'updated_at'
        ])
        && request.resource.data.role in ['admin', 'attendant', 'technician']
        && request.resource.data.status in ['active', 'inactive', 'invited']
        && (
          request.resource.data.status == resource.data.status
          || validSeatStatusChange(resource.data.company_id,
            resource.data.user_email, membershipId,
            resource.data.status, request.resource.data.status)
        );
      allow delete: if signedIn() && (
        (resource.data.company_id is string && isAdmin(resource.data.company_id)
          && (
            (resource.data.status == 'inactive' && !existsAfter(membershipPath(membershipId)))
            || seatReleaseAfter(resource.data.company_id, resource.data.user_email, membershipId)
          ))
        || (resource.data.user_email == request.auth.token.email
          && resource.data.status == 'invited'
          && existsAfter(/databases/$(database)/documents/invites/$(request.auth.token.email))
          && getAfter(/databases/$(database)/documents/invites/$(request.auth.token.email)).data.status == 'accepted'
          && getAfter(/databases/$(database)/documents/invites/$(request.auth.token.email)).data.accepted_by == request.auth.uid
          && getAfter(/databases/$(database)/documents/invites/$(request.auth.token.email)).data.company_id == resource.data.company_id)
      );
    }

    match /companyAccounts/{companyId} {
      allow read: if isMember(companyId) || platformAdmin();
      allow create: if platformAdmin() || (signedIn()
        && existsAfter(memberPath(companyId, request.auth.uid))
        && getAfter(memberPath(companyId, request.auth.uid)).data.role == 'admin'
        && request.resource.data.reserved_users == 1);
      allow update: if platformAdmin() || (
        isAdmin(companyId)
        && (
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'reserved_users', 'seat_change_email', 'seat_change_member_id', 'seat_change_action',
              'seat_change_at', 'updated_at'
            ])
            && request.resource.data.seat_change_email is string
            && request.resource.data.seat_change_at == request.time
            && (
              (request.resource.data.seat_change_action == 'reserve'
                && request.resource.data.reserved_users == resource.data.reserved_users + 1
                && request.resource.data.reserved_users <= resource.data.max_users
                && request.resource.data.seat_change_member_id is string
                && existsAfter(membershipPath(request.resource.data.seat_change_member_id))
                && getAfter(membershipPath(request.resource.data.seat_change_member_id)).data.company_id == companyId
                && getAfter(membershipPath(request.resource.data.seat_change_member_id)).data.status in ['invited', 'active'])
              || (request.resource.data.seat_change_action == 'release'
                && request.resource.data.reserved_users == resource.data.reserved_users - 1
                && request.resource.data.reserved_users >= 1
                && request.resource.data.seat_change_member_id is string
                && (!existsAfter(membershipPath(request.resource.data.seat_change_member_id))
                  || getAfter(membershipPath(request.resource.data.seat_change_member_id)).data.status == 'inactive')
                && (!existsAfter(memberPath(companyId, request.resource.data.seat_change_member_id))
                  || getAfter(memberPath(companyId, request.resource.data.seat_change_member_id)).data.status == 'inactive'))
            )
          )
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'orders_month_year', 'orders_month_number', 'orders_month_count', 'orders_month_updated_at'
            ])
            && request.resource.data.orders_month_updated_at == request.time
            && validOrderUsageAfter(companyId)
          )
        )
      );
      allow delete: if false;
    }

    match /{collectionName}/{recordId} {
      allow read: if (platformAdmin() && collectionName in ['auditLogs', 'planRequests'])
        || (collectionName == 'serviceOrders'
          && sameCompanyRecord()
          && (
            role(resource.data.company_id) in ['admin', 'attendant']
            || (role(resource.data.company_id) == 'technician'
              && resource.data.doc_type == 'ordem'
              && resource.data.technician_uid == request.auth.uid)
          ))
        || (collectionName in ['clients', 'equipment']
          && sameCompanyRecord()
          && role(resource.data.company_id) in ['admin', 'attendant'])
        || (collectionName in ['transactions', 'auditLogs', 'planRequests']
          && sameCompanyRecord()
          && isAdmin(resource.data.company_id))
        || (collectionName == 'orderEvents'
          && sameCompanyRecord()
          && (
            role(resource.data.company_id) in ['admin', 'attendant']
            || (role(resource.data.company_id) == 'technician'
              && resource.data.order_id is string
              && exists(/databases/$(database)/documents/serviceOrders/$(resource.data.order_id))
              && get(/databases/$(database)/documents/serviceOrders/$(resource.data.order_id)).data.company_id == resource.data.company_id
              && get(/databases/$(database)/documents/serviceOrders/$(resource.data.order_id)).data.doc_type == 'ordem'
              && get(/databases/$(database)/documents/serviceOrders/$(resource.data.order_id)).data.technician_uid == request.auth.uid)
          ));
      allow create: if collectionName in [
        'serviceOrders', 'clients', 'equipment', 'transactions',
        'orderEvents', 'auditLogs', 'planRequests'
      ] && sameCompanyWrite()
        && (
          (collectionName in ['clients', 'equipment']
            && role(request.resource.data.company_id) in ['admin', 'attendant'])
          || (collectionName == 'serviceOrders'
            && role(request.resource.data.company_id) in ['admin', 'attendant']
            && validTechnicianAssignment(request.resource.data.company_id, request.resource.data)
            && (request.resource.data.doc_type != 'ordem'
              || orderUsageWithinLimitAfter(request.resource.data.company_id)))
          || (collectionName == 'transactions'
            && role(request.resource.data.company_id) == 'admin')
          || (collectionName in ['orderEvents', 'auditLogs']
            && (
              role(request.resource.data.company_id) in ['admin', 'attendant']
              || (collectionName == 'orderEvents'
                && role(request.resource.data.company_id) == 'technician'
                && request.resource.data.order_id is string
                && exists(/databases/$(database)/documents/serviceOrders/$(request.resource.data.order_id))
                && get(/databases/$(database)/documents/serviceOrders/$(request.resource.data.order_id)).data.company_id == request.resource.data.company_id
                && get(/databases/$(database)/documents/serviceOrders/$(request.resource.data.order_id)).data.doc_type == 'ordem'
                && get(/databases/$(database)/documents/serviceOrders/$(request.resource.data.order_id)).data.technician_uid == request.auth.uid)
            ))
          || (collectionName == 'planRequests'
            && role(request.resource.data.company_id) == 'admin')
        );
      allow update: if (
        collectionName == 'planRequests'
        && platformAdmin()
        && request.resource.data.company_id == resource.data.company_id
        && request.resource.data.status in ['pending', 'contacted', 'done', 'canceled']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'updated_date', 'updated_at'
        ])
      ) || (
        collectionName in ['serviceOrders', 'clients', 'equipment', 'transactions']
        && sameCompanyRecord() && sameCompanyWrite()
        && request.resource.data.company_id == resource.data.company_id
        && (
          (collectionName in ['clients', 'equipment']
            && role(resource.data.company_id) in ['admin', 'attendant'])
          || (collectionName == 'serviceOrders'
            && (
              (('technician_uid' in request.resource.data)
                && ('technician_uid' in resource.data)
                && request.resource.data.technician_uid == resource.data.technician_uid)
              || validTechnicianAssignment(resource.data.company_id, request.resource.data)
            )
            && (
              role(resource.data.company_id) == 'admin'
              || (role(resource.data.company_id) == 'attendant'
                && request.resource.data.status == resource.data.status
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                  'client_id', 'client_name', 'client_document', 'client_phone',
                  'client_email', 'client_address', 'equipment_id', 'equipment_name',
                  'equipment_brand', 'equipment_model', 'equipment_serial',
                  'equipment_accessories', 'equipment_condition', 'reported_issue',
                  'diagnosis', 'solution', 'items', 'services_total', 'parts_total',
                  'discount', 'surcharge', 'total', 'technician', 'technician_uid', 'notes',
                  'warranty_terms', 'warranty_days', 'search_key',
                  'updated_date', 'updated_at'
                ]))
              || (role(resource.data.company_id) == 'technician'
                && resource.data.doc_type == 'ordem'
                && resource.data.status in [
                  'Aprovado', 'Aguardando aprovação', 'Aguardando equipamento',
                  'Em execução', 'Aguardando peça', 'Concluído', 'Aguardando retirada'
                ]
                && resource.data.technician_uid == request.auth.uid
                && request.resource.data.technician_uid == resource.data.technician_uid
                && (
                  (request.resource.data.status == resource.data.status
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      'diagnosis', 'solution', 'updated_date', 'updated_at'
                    ]))
                  || (request.resource.data.status in [
                    'Aguardando equipamento', 'Em execução', 'Aguardando peça',
                    'Concluído', 'Aguardando retirada'
                  ]
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                      'status', 'updated_date', 'updated_at'
                    ]))
                ))
            ))
          || (collectionName == 'transactions'
            && role(resource.data.company_id) == 'admin')
        )
      );
      allow delete: if collectionName in [
        'serviceOrders', 'clients', 'equipment', 'transactions', 'orderEvents'
      ] && sameCompanyRecord() && isAdmin(resource.data.company_id);
    }

    match /plans/{planId} {
      allow read: if signedIn();
      allow write: if platformAdmin();
    }
  }
}