rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function memberPath(companyId, uid) {
      return /databases/$(database)/documents/companies/$(companyId)/members/$(uid);
    }
    function isMember(companyId) {
      return signedIn()
        && exists(memberPath(companyId, request.auth.uid))
        && get(memberPath(companyId, request.auth.uid)).data.status == 'active';
    }
    function role(companyId) {
      return isMember(companyId)
        ? get(memberPath(companyId, request.auth.uid)).data.role
        : '';
    }
    function isAdmin(companyId) {
      return role(companyId) == 'admin';
    }
    function sameCompanyRecord() {
      return signedIn()
        && resource.data.company_id is string
        && isMember(resource.data.company_id);
    }
    function sameCompanyWrite() {
      return signedIn()
        && request.resource.data.company_id is string
        && isMember(request.resource.data.company_id);
    }
    function platformAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.platform_role == 'platform_admin';
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid
        && !('platform_role' in request.resource.data);
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['full_name', 'photo_url', 'updated_at', 'company_id', 'company_name', 'company_role'])
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['company_id'])
          || (request.resource.data.company_id is string
            && existsAfter(memberPath(request.resource.data.company_id, uid)))
        );
      allow delete: if false;
    }

    match /companies/{companyId} {
      allow read: if isMember(companyId);
      allow create: if signedIn()
        && request.resource.data.owner_uid == request.auth.uid
        && existsAfter(memberPath(companyId, request.auth.uid))
        && getAfter(memberPath(companyId, request.auth.uid)).data.role == 'admin';
      allow update: if isAdmin(companyId)
        && request.resource.data.owner_uid == resource.data.owner_uid
        && request.resource.data.company_id == resource.data.company_id;
      allow delete: if false;

      match /members/{uid} {
        allow read: if signedIn() && (
          request.auth.uid == uid || isAdmin(companyId)
        );
        allow create: if signedIn() && (
          (request.auth.uid == uid
            && exists(/databases/$(database)/documents/invites/$(request.auth.token.email))
            && get(/databases/$(database)/documents/invites/$(request.auth.token.email)).data.company_id == companyId
            && get(/databases/$(database)/documents/invites/$(request.auth.token.email)).data.status == 'pending')
          || (request.auth.uid == uid
            && getAfter(/databases/$(database)/documents/companies/$(companyId)).data.owner_uid == uid
            && request.resource.data.role == 'admin')
          || isAdmin(companyId)
        );
        allow update: if isAdmin(companyId)
          && request.resource.data.uid == resource.data.uid;
        allow delete: if isAdmin(companyId) && uid != request.auth.uid;
      }

      match /counters/{counterId} {
        allow read: if isMember(companyId);
        allow create: if isMember(companyId)
          && request.resource.data.key == 'doc'
          && request.resource.data.value is int
          && request.resource.data.value > 0;
        allow update: if isMember(companyId)
          && request.resource.data.key == 'doc'
          && request.resource.data.value is int
          && request.resource.data.value > resource.data.value;
        allow delete: if false;
      }

      match /auditLogs/{logId} {
        allow read: if isAdmin(companyId);
        allow create: if isMember(companyId);
        allow update, delete: if false;
      }
    }

    match /invites/{email} {
      allow read: if signedIn() && request.auth.token.email == resource.data.email;
      allow create, update: if signedIn()
        && request.resource.data.company_id is string
        && isAdmin(request.resource.data.company_id);
      allow delete: if signedIn() && (
          (resource.data.company_id is string && isAdmin(resource.data.company_id))
          || (resource.data.user_email == request.auth.token.email
            && resource.data.status == 'invited')
        );
    }

    match /memberships/{membershipId} {
      allow read: if signedIn() && (
        membershipId == request.auth.uid
        || (resource.data.company_id is string && isAdmin(resource.data.company_id))
      );
      allow create: if signedIn() && (
        (membershipId == request.auth.uid
          && request.resource.data.user_id == request.auth.uid
          && existsAfter(memberPath(request.resource.data.company_id, request.auth.uid)))
        || (request.resource.data.company_id is string && isAdmin(request.resource.data.company_id))
      );
      allow update: if signedIn() && resource.data.company_id is string
        && isAdmin(resource.data.company_id)
        && request.resource.data.company_id == resource.data.company_id;
      allow delete: if signedIn() && resource.data.company_id is string
        && isAdmin(resource.data.company_id);
    }

    match /companyAccounts/{companyId} {
      allow read: if isAdmin(companyId);
      allow create: if signedIn() && existsAfter(memberPath(companyId, request.auth.uid))
        && getAfter(memberPath(companyId, request.auth.uid)).data.role == 'admin';
      allow update: if isAdmin(companyId);
      allow delete: if false;
    }

    match /{collectionName}/{recordId} {
      allow read: if collectionName in [
        'serviceOrders', 'clients', 'equipment', 'transactions',
        'orderEvents', 'auditLogs', 'counters', 'planRequests'
      ] && sameCompanyRecord();
      allow create: if collectionName in [
        'serviceOrders', 'clients', 'equipment', 'transactions',
        'orderEvents', 'auditLogs', 'planRequests'
      ] && sameCompanyWrite()
        && (role(request.resource.data.company_id) == 'admin'
          || (collectionName != 'transactions' && role(request.resource.data.company_id) in ['attendant', 'technician']));
      allow update: if collectionName in [
        'serviceOrders', 'clients', 'equipment', 'transactions', 'planRequests'
      ] && sameCompanyRecord() && sameCompanyWrite()
        && (role(resource.data.company_id) == 'admin'
          || (collectionName != 'transactions' && role(resource.data.company_id) in ['attendant', 'technician']));
      allow delete: if collectionName in [
        'serviceOrders', 'clients', 'equipment', 'transactions'
      ] && sameCompanyRecord() && isAdmin(resource.data.company_id);
    }

    match /plans/{planId} {
      allow read: if signedIn();
      allow write: if platformAdmin();
    }
  }
}